# TalentHunt Server Configuration
PORT=3000
NODE_ENV=production
# Mandatory in production: High-entropy secret key (min 32 characters, e.g. generated via `openssl rand -base64 32`)
JWT_SECRET=your_high_entropy_jwt_secret_min_32_characters_here
DOMAIN=yourdomain.com

# Database Configuration:
# To use cloud PostgreSQL (Neon, Supabase, Render PostgreSQL), set DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# If DATABASE_URL is unset, TalentHunt automatically falls back to local SQLite in /data.
# DATA_DIR=/data

# Administrator Credentials:
# Mandatory for fresh production database initialization. Must be set prior to first deployment.
# ADMIN_PASSWORD=YourStrongUniqueAdminPasswordHere!
# ADMIN_EMAIL=abhijit.jitu4u@gmail.com
