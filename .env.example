# Database Configuration:
# To use cloud PostgreSQL (Neon, Supabase, Render PostgreSQL), set DATABASE_URL:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# If DATABASE_URL is unset, TalentHunt automatically falls back to local SQLite in /data.
# DATA_DIR=/data

# Administrator Credentials:
# Set custom administrator password in production (defaults to Admin@2026 if unset)
# ADMIN_PASSWORD=YourStrongAdminPassword2026!
